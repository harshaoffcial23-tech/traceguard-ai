# TraceGuard AI Environment Configuration

# Server configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database configuration
DATABASE_URL=sqlite:///./traceguard.db

# Security & Redaction
STRICT_GATEWAY_ENFORCEMENT=true
ENABLE_DATA_EXPOSURE_INSPECTION=true
MASK_SECRETS_IN_AUDIT=true

# External AI Provider (Optional - TraceGuard works 100% offline with deterministic mock agent)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# External Search Provider (Optional for external content indirect-injection testing)
TAVILY_API_KEY=
